+void ReportPipelineBuildWait(std::chrono::steady_clock::duration wait) {
+    using Clock = std::chrono::steady_clock;
+    static Clock::time_point window{Clock::now()};
+    static Clock::duration total{};
+    static Clock::duration longest{};
+    static u32 waits{};
+    static u32 logged{};
+    const auto ms = [](Clock::duration value) {
+        return std::chrono::duration<double, std::milli>(value).count();
+    };
+    total += wait;
+    longest = std::max(longest, wait);
+    ++waits;
+    if (wait > std::chrono::milliseconds{100} && logged < 200) {
+        ++logged;
+        LOG_INFO(Render_Vulkan, "The GPU worker waited {:.1f} ms for a pipeline being built",
+                 ms(wait));
+    }
+    const auto now{Clock::now()};
+    if (now - window > std::chrono::seconds{10}) {
+        LOG_INFO(Render_Vulkan,
+                 "Pipeline build waits in the last {:.0f} s: {}, {:.1f} ms in all, longest {:.1f} ms",
+                 std::chrono::duration<double>(now - window).count(), waits, ms(total), ms(longest));
+        window = now;
+        total = {};
+        longest = {};
+        waits = 0;
+    }
+}
